{
    "name": "chexnet-v3-backend",
    "version": "1.0.0",
    "description": "CheXNet V3 Clinical Precision AI - Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
        "build": "rimraf dist && tsc && tscpaths -p tsconfig.json -s src -o dist",
        "start": "node dist/server.js",
        "lint": "eslint 'src/**/*.ts'",
        "format": "prettier --write 'src/**/*.ts'"
    },
    "dependencies": {
        "axios": "^1.9.0",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "form-data": "^4.0.2",
        "ioredis": "^5.10.1",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.2",
        "moment-timezone": "^0.6.0",
        "mongoose": "^9.1.5",
        "multer": "^2.0.2",
        "node-cron": "^4.2.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/minimatch": "^6.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.15.21",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^10.0.0",
        "@types/yamljs": "^0.2.34",
        "eslint": "^9.28.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "tscpaths": "^0.0.9",
        "typescript": "^5.9.3"
    }
}
