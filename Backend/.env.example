PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/chexnet_v3?retryWrites=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=chexnet::
JWT_PRIVATE_KEY=chexnet-v3-super-secret-jwt-key-2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CRYPTO_SECRET=chexnet-v3-aes-256-crypto-secret-key
AI_SERVICE_URL=http://localhost:8000

# ── AI service (file Backend/ai_service/.env) ─────────────────────────────────
XRAY_AI_VALIDATE=true
XRAY_VALIDATE_STRICT=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
