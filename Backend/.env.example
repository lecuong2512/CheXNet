PORT=3006
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chexnet_hybrid_local?retryWrites=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=chexnet-hybrid::
JWT_PRIVATE_KEY=replace-with-a-random-local-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CRYPTO_SECRET=replace-with-a-random-local-secret
AI_SERVICE_URL=http://127.0.0.1:8000

# ── AI service (file Backend/ai_service/.env) ─────────────────────────────────
XRAY_AI_VALIDATE=true
XRAY_VALIDATE_STRICT=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=debug
